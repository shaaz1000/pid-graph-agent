GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# NVIDIA-hosted inference (OpenAI-compatible). Used when LLM_PROVIDER=nvidia; LLM_MODEL must
# name a tool-calling model NVIDIA hosts. LLM_BASE_URL is optional (default shown).
NVIDIA_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional alternative providers. One is used only when LLM_PROVIDER names it
# (openrouter or deepseek) and LLM_MODEL is set to a model id it serves.
# There is no automatic failover between providers.
OPENROUTER_API_KEY=
DEEP_SEEK_API_KEY=
