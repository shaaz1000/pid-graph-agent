GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Optional alternative providers. One is used only when LLM_PROVIDER names it
# (openrouter or deepseek) and LLM_MODEL is set to a model id it serves.
# There is no automatic failover between providers.
OPENROUTER_API_KEY=
DEEP_SEEK_API_KEY=
