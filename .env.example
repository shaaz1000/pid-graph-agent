# Default: an open-weight model through NVIDIA-hosted inference (OpenAI-compatible API).
NVIDIA_API_KEY=
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_TIMEOUT_SECONDS=240

# Optional alternative providers. One is used only when LLM_PROVIDER names it
# (groq, openrouter or deepseek). groq defaults to openai/gpt-oss-20b; for the others LLM_MODEL
# must be set to a model id they serve. There is no automatic failover between providers.
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEP_SEEK_API_KEY=
